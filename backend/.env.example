# Backend runtime settings for production or local development
PORT=3000
HOST=127.0.0.1
NODE_ENV=production

# WISS booth (single Node process; persistent sessions and assets)
# WISS_DATA_DIR=/absolute/private/path/wiss
# WISS_PUBLIC_URL=https://photo-interface.com
# WISS_DRAFT_TTL_MS=3600000

# Server-side OAuth only. The account must have write access to both folders.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# DRIVE_RESEARCH_FOLDER_ID=
# DRIVE_SHARED_FOLDER_ID=
# Optional separate OAuth accounts override the GOOGLE_* fallback per destination.
# DRIVE_RESEARCH_CLIENT_ID=
# DRIVE_RESEARCH_CLIENT_SECRET=
# DRIVE_RESEARCH_REFRESH_TOKEN=
# DRIVE_SHARED_CLIENT_ID=
# DRIVE_SHARED_CLIENT_SECRET=
# DRIVE_SHARED_REFRESH_TOKEN=

# Researcher notification (no participant email addresses collected)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# WISS_NOTIFY_TO=
